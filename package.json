{
  "name": "twincat-assistant",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-extension.mjs",
    "test:browser": "playwright test",
    "test:native-mcp": "node --test tests/integration/native-mcp.test.mjs",
    "check": "npm test && npm run build && npm run test:browser",
    "assistant": "node src/cli.mjs"
  },
  "dependencies": {
    "@openchamber/sdk": "2.1.1",
    "@opencode/schema": "2.0.23",
    "effect": "4.0.0-rc.112",
    "@modelcontextprotocol/client": "2.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.25.12"
  }
}
