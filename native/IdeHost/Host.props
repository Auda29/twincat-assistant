<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>TwinCatAssistant.IdeHost</AssemblyName>
    <RootNamespace>TwinCatAssistant.Native</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <UseCodebase>true</UseCodebase>
    <DeployExtension>false</DeployExtension>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TwinCatInteropPath Condition="'$(TwinCatInteropPath)' == ''">C:\TwinCAT\3.1\Components\TcBlockDiagram\Common\TCatSysManagerLib.dll</TwinCatInteropPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="$(ShellPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="EnvDTE" Version="$(DtePackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="15.8.209" ExcludeAssets="runtime" Condition="'$(DtePackageVersion)' == '8.0.2'" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Design" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="TCatSysManagerLib"><HintPath>$(TwinCatInteropPath)</HintPath><Private>true</Private><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
    <Compile Include="../AssistantPackage.cs;../AssistantControl.cs;../AssistantTheme.cs;../ActiveEditorTracker.cs;../NativeChatRuntime.cs;../ChatIntegration.cs;../ChatBindingStore.cs;../../Shared/ChatContextBinding.cs;../../Shared/ChatConnectionState.cs;../../Shared/NativeProjectReader.cs;../../Shared/DirtyEvidence.cs;../../Shared/ActiveEditorContext.cs;../../Shared/ActivePouSource.cs;../../Shared/NativeActiveEditorReader.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../obj/EmbeddedChat.js" LogicalName="TwinCatAssistant.EmbeddedChat.js" />
    <Compile Include="../NativeModelConsent.cs" Link="Shared/NativeModelConsent.cs" />
    <VSCTCompile Include="../Commands.vsct"><ResourceName>Menus.ctmenu</ResourceName></VSCTCompile>
    <None Include="source.extension.vsixmanifest"><SubType>Designer</SubType></None>
  </ItemGroup>
  <Target Name="RequireTwinCatInterop" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)obj/EmbeddedChat.js')" Text="Build the pinned embedded adapter with node scripts/build-embedded-chat.mjs or use scripts/Build-Native.ps1 first." />
    <Error Condition="!Exists('$(TwinCatInteropPath)')" Text="Select the installed TwinCAT interop assembly with /p:TwinCatInteropPath=...; no vendor assembly is committed." />
  </Target>
</Project>
