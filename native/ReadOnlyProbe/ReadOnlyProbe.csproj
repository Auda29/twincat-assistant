<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TwinCatInteropPath Condition="'$(TwinCatInteropPath)' == ''">C:\TwinCAT\3.1\Components\TcBlockDiagram\Common\TCatSysManagerLib.dll</TwinCatInteropPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="EnvDTE" Version="8.0.2" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="TCatSysManagerLib"><HintPath>$(TwinCatInteropPath)</HintPath><Private>true</Private><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireTwinCatInterop" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TwinCatInteropPath)')" Text="Select the installed TwinCAT interop assembly with /p:TwinCatInteropPath=...; no vendor assembly is bundled." />
  </Target>
</Project>
